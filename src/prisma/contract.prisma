// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?  @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model About {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  level     Int?
  iconUrl   String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  technologies String?
  featured    Boolean  @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean  @default(false)
  publishedAt TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Experience {
  id          Int      @id @default(autoincrement())
  company     String
  position    String
  description String
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  position  String?
  message   String
  imageUrl  String?
  featured  Boolean  @default(false)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  iconUrl     String?
  featured    Boolean  @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  type      String?
  size      Int?
  createdAt TimestamptzString @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt TimestamptzString @default(now())
}